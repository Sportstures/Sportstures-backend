    {
      "id": "b633c664-7c8b-401f-8517-e689c6827d59",
      "name": "Optional checks",
      "description": "Error cases and the resend cooldown. Each says when to run it.",
      "item": [
        {
          "id": "c8e7a8a6-342b-4749-bb4a-9315b6bbecf7",
          "name": "Register learner who skipped sport (sport: null)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "id": "464cccff-2141-4b38-8103-8488d98065f1",
                "type": "text/javascript",
                "exec": [
                  "const inbox = pm.collectionVariables.get('testInbox');",
                  "if (inbox && inbox.includes('@') && !inbox.startsWith('replace-')) {",
                  "  const [local, domain] = inbox.split('@');",
                  "  pm.collectionVariables.set('learnerNoSportEmail', local + '+learnerNoSport' + Date.now() + '@' + domain);",
                  "} else if (!pm.collectionVariables.get('learnerNoSportEmail')) {",
                  "  throw new Error('Set the testInbox collection variable to an inbox you can read, for example you@gmail.com');",
                  "}",
                  "console.log('Registering learnerNoSport:', pm.collectionVariables.get('learnerNoSportEmail'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "id": "9930e53f-252c-45e2-98f5-4bbadd347452",
                "type": "text/javascript",
                "exec": [
                  "pm.test('Learner without a sport registers with 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response includes a numeric userId and no tokens', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.userId).to.be.a('number');",
                  "  pm.expect(body).not.to.have.property('accessToken');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "The sport step is optional. Sends sport: null, as the app does when the learner skips it. Sends a real verification email to a fresh address from testInbox.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"learner\",\n  \"firstName\": \"Sipho\",\n  \"lastName\": \"Nkosi\",\n  \"dateOfBirth\": \"2010-07-21\",\n  \"gender\": \"male\",\n  \"school\": {\n    \"name\": \"Greenwood High\",\n    \"grade\": 9,\n    \"className\": \"9B\"\n  },\n  \"sport\": null,\n  \"email\": \"{{learnerNoSportEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "id": "bf7ba3ac-d231-4305-b400-3cdd473edf63",
          "name": "Register learner who skipped sport (sport omitted)",
