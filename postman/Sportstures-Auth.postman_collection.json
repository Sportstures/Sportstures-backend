{
  "info": {
    "_postman_id": "f7a40f6a-a2a8-4c08-a0b2-715f5bd56c19",
    "name": "Sportstures - Auth",
    "description": "Tests learner and coach signup, email OTP verification, login, token refresh and logout.\n\nSetup:\n1. Start the backend with SMTP configured (see README).\n2. Set the testInbox collection variable to an inbox you can read, for example you@gmail.com. Each register request creates a fresh address like you+coach1730000000000@gmail.com, so you can rerun without changing anything. If your inbox does not support +addresses, clear testInbox and set learnerEmail / coachEmail directly.\n3. Run \"1. Register\" in a folder, copy the emailed code into learnerOtp or coachOtp, then run the rest of that folder in order.\n\nThe auth endpoints allow AUTH_RATE_LIMIT_MAX attempts per IP per 15 minutes, and OTP endpoints allow 10.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "id": "20f256b9-dcc9-4701-9a41-96bd3641f71d",
      "name": "Learner signup",
      "description": "Register, verify by email, then log in. Run in order. The sport step is optional; see Optional checks for a learner who skips it.",
      "item": [
        {
          "id": "2fa0e021-0a75-4dcf-a103-44d0ca239d7c",
          "name": "1. Register learner",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "id": "33ca80f4-e16f-4730-ab72-f18dd16d2e63",
                "type": "text/javascript",
                "exec": [
                  "const inbox = pm.collectionVariables.get('testInbox');",
                  "if (inbox && inbox.includes('@') && !inbox.startsWith('replace-')) {",
                  "  const [local, domain] = inbox.split('@');",
                  "  pm.collectionVariables.set('learnerEmail', local + '+learner' + Date.now() + '@' + domain);",
                  "} else if (!pm.collectionVariables.get('learnerEmail')) {",
                  "  throw new Error('Set the testInbox collection variable to an inbox you can read, for example you@gmail.com');",
                  "}",
                  "console.log('Registering learner:', pm.collectionVariables.get('learnerEmail'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "id": "c25bf193-efc3-45b3-8f17-6b755bb31a5b",
                "type": "text/javascript",
                "exec": [
                  "pm.test('Learner registration returns 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response includes a numeric userId and no tokens', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.userId).to.be.a('number');",
                  "  pm.expect(body).not.to.have.property('accessToken');",
                  "  pm.collectionVariables.set('learnerUserId', String(body.userId));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates an unverified learner (Lerato Dlamini, Grade 10 at Greenwood High, Netball) with the optional sport step filled in, and emails a six-digit code to learnerEmail. A new email is generated from testInbox on every send.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"learner\",\n  \"firstName\": \"Lerato\",\n  \"lastName\": \"Dlamini\",\n  \"dateOfBirth\": \"2009-03-14\",\n  \"gender\": \"female\",\n  \"school\": {\n    \"name\": \"Greenwood High\",\n    \"grade\": 10,\n    \"className\": \"10A\"\n  },\n  \"sport\": {\n    \"name\": \"Netball\",\n    \"teamName\": \"Greenwood Girls U16\",\n    \"jerseyNumber\": 7,\n    \"level\": \"U16\"\n  },\n  \"email\": \"{{learnerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "id": "950e78ef-75c9-411c-a3c7-8fbed05bda86",
          "name": "2. Login before verification (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "c5b3e3c4-69c2-4b98-9011-9dce63df5517",
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unverified login is rejected with 403 EMAIL_NOT_VERIFIED', () => {",
                  "  pm.response.to.have.status(403);",
                  "  pm.expect(pm.response.json().error.code).to.eql('EMAIL_NOT_VERIFIED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Unverified accounts cannot log in.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{learnerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "id": "08c0a93b-a66e-48f3-89ad-ffc4c4d6d42c",
          "name": "3. Verify learner OTP",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "id": "cc304c9e-84a3-4ef4-a71f-e0c5a7fc4bce",
                "type": "text/javascript",
                "exec": [
                  "const code = pm.collectionVariables.get('learnerOtp');",
                  "if (!/^\\d{6}$/.test(code || '') || code === '000000') {",
                  "  throw new Error('Copy the six-digit code from the learner verification email into the learnerOtp collection variable, then send this again');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "id": "6da3b090-1bc6-4657-b725-0bc8ccfd6cd4",
                "type": "text/javascript",
                "exec": [
                  "pm.test('OTP verification returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Learner is told to log in', () => {",
                  "  pm.expect(pm.response.json().message).to.eql('Account verified. You can now log in.');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-otp"
              ]
            },
            "description": "Set learnerOtp to the code from the email first. Codes expire after 10 minutes and allow five wrong attempts. Learners are not signed in here; they log in next.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{learnerEmail}}\",\n  \"code\": \"{{learnerOtp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "id": "8df1f438-3526-4542-9bd2-b8046744b418",
          "name": "4. Login learner",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "fd9ffc92-2c82-4a06-bc86-8656a11f86a1",
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verified login returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Login returns the learner and tokens', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user.role).to.eql('learner');",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('learnerAccessToken', body.accessToken);",
                  "  pm.collectionVariables.set('learnerRefreshToken', body.refreshToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Signs in the verified learner and saves learnerAccessToken and learnerRefreshToken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{learnerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "id": "1804db3e-9d17-4dfe-b96a-51824269c022",
          "name": "5. Get current learner",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "b12bf388-fea8-41c5-961a-670c25dd6235",
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('Authenticated user is the registered learner', () => {",
                  "  const { user } = pm.response.json();",
                  "  pm.expect(user.role).to.eql('learner');",
                  "  pm.expect(user.email.toLowerCase()).to.eql(pm.collectionVariables.get('learnerEmail').toLowerCase());",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            },
            "description": "Checks the learner access token.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{learnerAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "id": "c6d1c1e0-f27c-4c95-965f-c2bc83e348ba",
          "name": "6. Refresh learner tokens",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "342bf722-fb4c-440d-8649-2fe7963208b5",
                "type": "text/javascript",
                "exec": [
                  "pm.test('Refresh returns 200 with a new pair', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.refreshToken).to.not.eql(pm.collectionVariables.get('learnerRefreshToken'));",
                  "  pm.collectionVariables.set('learnerAccessToken', body.accessToken);",
                  "  pm.collectionVariables.set('learnerRefreshToken', body.refreshToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "Refresh tokens are single use, so this saves the new pair.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{learnerRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "id": "fdc372ab-4677-4ac2-b7ce-926698c8e879",
          "name": "7. Logout learner",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "3675e0ba-1072-41fe-b58c-90a4db6c078d",
                "type": "text/javascript",
                "exec": [
                  "pm.test('Logout returns 200', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().message).to.eql('Logged out');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the refresh token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{learnerRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
