            {
              "listen": "test",
              "script": {
                "id": "4e8268cc-a437-4677-97d4-81392d81468c",
                "type": "text/javascript",
                "exec": [
                  "pm.test('Learner without a sport registers with 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response includes a numeric userId and no tokens', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.userId).to.be.a('number');",
                  "  pm.expect(body).not.to.have.property('accessToken');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "The sport step is optional. Leaves sport out of the body entirely. Sends a real verification email to a fresh address from testInbox.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"learner\",\n  \"firstName\": \"Sipho\",\n  \"lastName\": \"Nkosi\",\n  \"dateOfBirth\": \"2010-07-21\",\n  \"gender\": \"male\",\n  \"school\": {\n    \"name\": \"Greenwood High\",\n    \"grade\": 9,\n    \"className\": \"9B\"\n  },\n  \"email\": \"{{learnerNoSportEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
