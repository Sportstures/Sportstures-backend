        {
          "id": "6fa77a3f-da48-4053-8e86-09a543dfb93f",
          "name": "Resend learner OTP (run after 60s cooldown)",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "2db1e252-235d-4e65-a096-922d01024d73",
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resend succeeds or reports the cooldown', () => pm.expect([200, 429]).to.include(pm.response.code));",
                  "pm.test('Response matches the status', () => {",
                  "  if (pm.response.code === 200) pm.expect(pm.response.json().retryAfterSeconds).to.be.a('number');",
                  "  else pm.expect(pm.response.headers.get('Retry-After')).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/resend-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "resend-otp"
              ]
            },
            "description": "Run after registering and before verifying. One resend per email every 60 seconds; a 429 with Retry-After is expected during the cooldown. A new code replaces the old one. Change the body to {{coachEmail}} to test a coach.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{learnerEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "id": "6c38498d-2185-40a9-8c59-f8bd24b7437c",
          "name": "Reject invalid learner signup (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "0694bf49-30dc-48d3-bff9-2204f1e22ee0",
                "type": "text/javascript",
                "exec": [
                  "pm.test('Returns 400 VALIDATION_ERROR with details', () => {",
                  "  pm.response.to.have.status(400);",
                  "  const { error } = pm.response.json();",
                  "  pm.expect(error.code).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(error.details.map((d) => d.field)).to.include('school');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Missing school details. Validation fails before anything is saved or emailed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"learner\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"Learner\",\n  \"dateOfBirth\": \"2009-03-14\",\n  \"gender\": \"female\",\n  \"email\": \"invalid-learner@example.com\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
