  "info": {
    "_postman_id": "f7a40f6a-a2a8-4c08-a0b2-715f5bd56c19",
    "name": "Sportstures - Player Auth",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Tests player registration, email OTP verification, login, resend cooldown, and an authenticated request. Set playerEmail to an inbox you can access, configure SMTP on the backend, then run the Happy path requests in order. After registration, copy the emailed six-digit code into the otp collection variable before running Verify OTP. Resend OTP is separate because the backend enforces a 60-second cooldown.",
      "type": "text/plain"
    }
  }
}