{
  "_": {
    "postman_id": "f7a40f6a-a2a8-4c08-a0b2-715f5bd56c19"
  },
  "item": [
    {
      "id": "10711a81-e0e4-4b86-8f90-e47ce7f27f64",
      "name": "Happy path",
      "item": [
        {
          "id": "1e701973-8813-4b61-be9c-4f3adfbb3d30",
          "name": "1. Register player",
          "request": {
            "description": {
              "content": "Creates a player account and sends a six-digit OTP to playerEmail. Replace the placeholder address with an inbox you can access. Change playerEmail before each new registration because email addresses are unique.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "auth",
                "register"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"player\",\n  \"firstName\": \"{{firstName}}\",\n  \"lastName\": \"{{lastName}}\",\n  \"dateOfBirth\": \"{{dateOfBirth}}\",\n  \"gender\": \"{{gender}}\",\n  \"school\": {\n    \"name\": \"{{schoolName}}\",\n    \"grade\": {{grade}},\n    \"className\": \"{{className}}\"\n  },\n  \"sport\": {\n    \"name\": \"{{sportName}}\",\n    \"teamName\": \"{{teamName}}\",\n    \"jerseyNumber\": {{jerseyNumber}},\n    \"level\": \"{{sportLevel}}\"\n  },\n  \"email\": \"{{playerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "00bc9446-788d-492b-977d-4133b7d73be1",
                "type": "text/javascript",
                "exec": [
                  "pm.test('Player registration returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response includes a numeric userId', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.userId).to.be.a('number');",
                  "  pm.collectionVariables.set('playerUserId', String(body.userId));",
                  "});",
                  "",
                  "pm.test('Registration does not issue tokens before verification', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).not.to.have.property('accessToken');",
                  "  pm.expect(body).not.to.have.property('refreshToken');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "id": "f6b9f63e-26f3-4bec-bc0c-b608153d60cc",
          "name": "2. Login before verification (expect 403)",
          "request": {
            "description": {
              "content": "Confirms unverified players cannot log in. Run after registration and before OTP verification.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "auth",
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{playerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "e01bcb05-0fc1-4081-bbb5-3734a9522f89",
                "type": "text/javascript",
                "exec": [
                  "pm.test('Unverified login is rejected with 403', function () {",
                  "  pm.response.to.have.status(403);",
                  "  pm.expect(pm.response.json().error.code).to.eql('EMAIL_NOT_VERIFIED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "id": "cdcf2a19-8d41-473a-a50d-77e555f2e9e6",
          "name": "3. Verify OTP",
          "request": {
            "description": {
              "content": "After registration, retrieve the six-digit code from the configured email inbox, set the collection variable otp, then send this request. Codes expire after 10 minutes.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "auth",
                "verify-otp"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{playerEmail}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "391e445a-3eaa-43e5-9c35-b4031895312a",
                "type": "text/javascript",
                "exec": [
                  "pm.test('OTP verification returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Verification response confirms success', function () {",
                  "  pm.expect(pm.response.json().message).to.eql('Account verified. You can now log in.');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "id": "0228d6ce-cc16-4bf5-90a0-9aceabbcb2b9",
          "name": "4. Login after verification",
          "request": {
            "description": {
              "content": "Signs in the now-verified player and saves accessToken and refreshToken as collection variables for subsequent requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "auth",
                "login"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{playerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "92b123b7-dcc7-4bda-bc72-55902c1720ca",
                "type": "text/javascript",
                "exec": [
                  "pm.test('Verified login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Login returns player details and tokens', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user.role).to.eql('player');",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "id": "bf55ec35-b323-497b-9278-af721c1495d5",
          "name": "5. Get current player",
          "request": {
            "description": {
              "content": "Checks the access token obtained from the verified login.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "auth",
                "me"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "type": "string",
                  "value": "{{accessToken}}",
                  "key": "token"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "0cb767c2-5f47-4284-903e-175a8486ca50",
                "type": "text/javascript",
                "exec": [
                  "pm.test('Current player request returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Authenticated user is the registered player', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user.role).to.eql('player');",
                  "  pm.expect(body.user.email.toLowerCase()).to.eql(pm.collectionVariables.get('playerEmail').toLowerCase());",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "event": []
    },
    {
      "id": "36c64ec4-5a77-4669-b120-2344fae506a6",
      "name": "Optional checks",
      "item": [
        {
          "id": "8abeea6d-e66f-4351-9c4e-e744f804955e",
          "name": "Resend OTP (run after cooldown)",
          "request": {
            "description": {
              "content": "Run with an unverified account. The endpoint limits resends to one per email every 60 seconds. A 429 is expected during cooldown; check Retry-After before retrying. A successful resend replaces the previous code.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "auth",
                "resend-otp"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{playerEmail}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "ae76a102-b917-4170-bd77-7e6af66f43e8",
                "type": "text/javascript",
                "exec": [
                  "pm.test('Resend succeeds or reports the active cooldown', function () {",
                  "  pm.expect([200, 429]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Cooldown response includes Retry-After', function () {",
                  "  if (pm.response.code === 429) {",
                  "    pm.expect(pm.response.headers.get('Retry-After')).to.be.a('string').and.not.empty;",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "id": "fcdcc834-3445-4252-8d90-323267d7ca72",
          "name": "Reject invalid player signup",
          "request": {
            "description": {
              "content": "Checks required school and class validation. The endpoint should return 400 before checking whether the email is already registered.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "auth",
                "register"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"player\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"Player\",\n  \"dateOfBirth\": \"2009-03-14\",\n  \"gender\": \"female\",\n  \"email\": \"{{playerEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "id": "dec7aac9-7191-4f9b-9666-928ef35667ee",
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid signup returns 400 validation error', function () {",
                  "  pm.response.to.have.status(400);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error.code).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(body.error.details).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "event": []
    }
  ],
