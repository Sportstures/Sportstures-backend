# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=sportstures
# Or one connection string instead of the five above (Render gives you this). Leave it out locally.
# SSL is switched on automatically for *.render.com hosts; DB_SSL=true/false overrides that.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_SSL=true

# Server Configuration
PORT=5000
NODE_ENV=development
# Behind a host's proxy (Render), set to 1 so rate limits see real visitor addresses. Leave unset locally.
# TRUST_PROXY=1

# Auth (generate the secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
# Register/login attempts allowed per IP per 15 minutes (default 20). Raise it while developing and testing signup.
AUTH_RATE_LIMIT_MAX=200

# Email verification (SMTP). Authenticated SMTP is optional when your relay allows it.
# With NODE_ENV=development and no SMTP_HOST/SMTP_FROM set, no email is sent: the server console prints
# the email subject, which contains the 6-digit code (use it to test signup locally).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Sportstures <no-reply@example.com>

# Public contact addresses (optional; these defaults are used when unset).
# Replies to automated emails go to CONTACT_EMAIL_SUPPORT. GET /api/contact returns them all.
CONTACT_EMAIL_SUPPORT=support@sportstures.co.za
CONTACT_EMAIL_INFO=info@sportstures.co.za
CONTACT_EMAIL_HELLO=hello@sportstures.co.za
CONTACT_EMAIL_PARTNERSHIPS=partnerships@sportstures.co.za
CONTACT_EMAIL_PRIVACY=privacy@sportstures.co.za
CONTACT_EMAIL_SECURITY=security@sportstures.co.za
CONTACT_EMAIL_BILLING=billing@sportstures.co.za
